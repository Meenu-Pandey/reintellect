# Copy this file to .env before running docker compose up
# cp .env.example .env

# Video source: path to video file or "demo" for bundled demo clip
VIDEO_SOURCE=demo

# GPU device (leave empty for CPU)
CUDA_VISIBLE_DEVICES=

# Logging level
LOG_LEVEL=INFO

# Store timezone
STORE_TIMEZONE=Asia/Kolkata

# Frontend origin for CORS (used by backend)
FRONTEND_ORIGIN=http://localhost:3000

# Vite environment (used at build time by frontend Docker stage)
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=
